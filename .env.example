# Port (Render sets this automatically)
PORT=3000

# Password to open the dashboard
ADMIN_PASSWORD=change-me

# Neon Postgres connection string (Neon console > Connect > copy the POOLED string)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Timezone used for "today" / overdue follow-ups
APP_TZ=Asia/Karachi

# --- Meta app (developers.facebook.com) ---
# Any random string; paste the same value in the Meta webhook "Verify token" box
META_VERIFY_TOKEN=pokitbio-verify-123
# App Settings > Basic > App Secret (used to verify webhook signatures)
META_APP_SECRET=
# Long-lived PAGE access token for the PokitBio Facebook page
META_PAGE_TOKEN=
# Facebook Page ID of PokitBio
META_PAGE_ID=
# Instagram Business account ID linked to that page (pokitbiogram)
META_IG_ID=

GRAPH_VERSION=v21.0
