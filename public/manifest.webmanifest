{
  "name": "PokitBio",
  "short_name": "PokitBio",
  "description": "PokitBio business app — leads, money, staff, reports",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#004AAD",
  "theme_color": "#004AAD",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Leads", "url": "/#leads", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add expense", "url": "/#expenses", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
